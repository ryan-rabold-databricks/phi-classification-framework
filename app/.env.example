# Local development only (npm run dev). Deployed values come from resources/review_app.yml.
DATABRICKS_HOST=https://<workspace-host>
DATABRICKS_WAREHOUSE_ID=<sql_warehouse_id>
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=<review_app_name>
PHI_ENV=dev
PHI_GOVERNANCE_CATALOG=<governance_catalog>
PHI_GOVERNANCE_SCHEMA=data_governance
PHI_GOVERNANCE_GROUP=<data governance group>
PHI_GOVERNED_CATALOG_PREFIX=dev_
PHI_TAG_KEY=phi_classification
PHI_SCAN_JOB_ID=<scan job id>
# dev only: comma-separated allowed values when no governed-tag policy exists
PHI_ALLOWED_VALUES_OVERRIDE=
# Identity used locally, where the Apps proxy headers are absent
PHI_DEV_USER_EMAIL=<you@example.com>
